# Environment variables go here, can be read by `python-dotenv` package:
#
#   ----------------------------------------------------------------
#    from dotenv import load_dotenv
#    
#    load_dotenv()
#    API_KEY = os.getenv("API_KEY")
#   ----------------------------------------------------------------
#
# DO NOT ADD THIS FILE TO VERSION CONTROL!


# API_KEY=your-api-key

# Langfuse tracing (Settings -> API Keys in your Langfuse project)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# No cloud LLM credentials needed - the model is local-only via Ollama +
# LiteLLM (config.DEFAULT_MODEL_URI, ADR-008). Run `ollama pull qwen2.5-coder:14b`.

# Where LiteLLM's ollama_chat provider finds Ollama. Leave unset when running
# directly on the host (defaults to http://localhost:11434). When running via
# `docker compose up`, docker-compose.yml sets this to
# http://host.docker.internal:11434 for you - do not set it here too.
# OLLAMA_API_BASE=http://localhost:11434